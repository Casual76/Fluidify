# Build output
build/
app/build/
core/build/
.gradle/
local.properties

# Fetched, not vendored (see fetchBungee in app/build.gradle.kts)
native-dsp/bungee/

# Cross-compiled by cargoBuild (in :core since the watch shares the engine;
# the old app path stays ignored so a stale checkout cannot commit it)
core/src/main/jniLibs/
app/src/main/jniLibs/
native/target/

# Native build scratch (CMake/Ninja, regenerated by every build)
app/.cxx/

# Local agent settings: machine-specific, and no business in a public repo
.claude/

# Signing. The keystore and its passwords never go near the repository.
*.jks
*.keystore
keystore.properties

# IDE
.idea/
*.iml
.DS_Store

# Network captures taken while reverse-engineering. They hold session
# headers, so they stay on the machine that made them. Whatever they are
# named: a capture saved as .txt is still a capture.
*.har
*.har.txt

# Cartella di sessione del compilatore Kotlin, rigenerata a ogni build.
.kotlin/

# Allegati delle sessioni remote di Codex: immagini locali, mai da versionare.
.codex-remote-attachments/

# Resoconti di QA locali, con le evidenze dei dispositivi.
docs/manual-qa-watch-2026-10-03.md
