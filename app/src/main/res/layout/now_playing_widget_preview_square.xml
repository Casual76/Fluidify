<?xml version="1.0" encoding="utf-8"?><!--
  L'anteprima del quadrato. Vedi now_playing_widget_preview_row.xml per il perche'
  di un layout statico e per il perche' di ImageView al posto di View.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_surface"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <ImageView
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/widget_preview_tile"
        android:contentDescription="@null"
        android:padding="16dp"
        android:src="@drawable/ic_app_mark"
        android:tint="@color/widget_preview_ink_dim" />

    <ImageView
        android:layout_width="72dp"
        android:layout_height="8dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/widget_preview_line"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/widget_preview_strip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="4dp">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:contentDescription="@null"
            android:padding="7dp"
            android:src="@drawable/ic_widget_previous"
            android:tint="@color/widget_preview_ink" />

        <ImageView
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/widget_preview_button_filled"
            android:contentDescription="@null"
            android:padding="10dp"
            android:src="@drawable/ic_widget_play"
            android:tint="@color/widget_preview_on_accent" />

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginStart="2dp"
            android:contentDescription="@null"
            android:padding="7dp"
            android:src="@drawable/ic_widget_next"
            android:tint="@color/widget_preview_ink" />
    </LinearLayout>
</LinearLayout>
