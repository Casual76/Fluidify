<?xml version="1.0" encoding="utf-8"?><!--
  L'anteprima del ritratto. Vedi now_playing_widget_preview_row.xml.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_surface"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="16dp">

    <ImageView
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:background="@drawable/widget_preview_tile"
        android:contentDescription="@null"
        android:padding="28dp"
        android:src="@drawable/ic_app_mark"
        android:tint="@color/widget_preview_ink_dim" />

    <ImageView
        android:layout_width="86dp"
        android:layout_height="9dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/widget_preview_line"
        android:contentDescription="@null" />

    <ImageView
        android:layout_width="56dp"
        android:layout_height="7dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_preview_line_dim"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/widget_preview_strip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="5dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@null"
            android:padding="8dp"
            android:src="@drawable/ic_widget_previous"
            android:tint="@color/widget_preview_ink" />

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/widget_preview_button_filled"
            android:contentDescription="@null"
            android:padding="12dp"
            android:src="@drawable/ic_widget_play"
            android:tint="@color/widget_preview_on_accent" />

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="2dp"
            android:contentDescription="@null"
            android:padding="8dp"
            android:src="@drawable/ic_widget_next"
            android:tint="@color/widget_preview_ink" />
    </LinearLayout>
</LinearLayout>
