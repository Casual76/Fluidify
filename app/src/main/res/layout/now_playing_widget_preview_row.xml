<?xml version="1.0" encoding="utf-8"?><!--
  Come si vede il widget, per chi lo sta scegliendo.

  Un layout statico e non il widget vero: il selettore chiede al sistema una
  anteprima e il sistema non puo' comporre Glance per mostrarla, quindi senza
  questo file mostra l'icona dell'app su bianco - che non dice niente di cosa si
  sta per aggiungere. Le righe non hanno parole dentro apposta: un titolo finto
  in un'anteprima e' un titolo che qualcuno prima o poi legge.

  I colori sono fissi con una coppia giorno/notte, perche' un'anteprima non ha
  modo di chiedere all'engine la sua tavolozza; stanno vicino a quello che
  engineWidgetPalette risolve per l'accento del marchio.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_surface"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/widget_preview_tile"
        android:contentDescription="@null"
        android:padding="14dp"
        android:src="@drawable/ic_app_mark"
        android:tint="@color/widget_preview_ink_dim" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!--
          ImageView e non View: un'anteprima viene gonfiata come RemoteViews, e
          RemoteViews accetta solo le classi del suo elenco. Un `View` nudo non
          c'e' dentro, e il risultato non e' un errore visibile - e' un
          rettangolo grigio al posto dell'anteprima.
        -->
        <ImageView
            android:layout_width="96dp"
            android:layout_height="9dp"
            android:background="@drawable/widget_preview_line"
            android:contentDescription="@null" />

        <ImageView
            android:layout_width="62dp"
            android:layout_height="7dp"
            android:layout_marginTop="7dp"
            android:background="@drawable/widget_preview_line_dim"
            android:contentDescription="@null" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_preview_strip"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="5dp">

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:contentDescription="@null"
            android:padding="8dp"
            android:src="@drawable/ic_widget_previous"
            android:tint="@color/widget_preview_ink" />

        <ImageView
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_marginStart="2dp"
            android:background="@drawable/widget_preview_button_filled"
            android:contentDescription="@null"
            android:padding="12dp"
            android:src="@drawable/ic_widget_play"
            android:tint="@color/widget_preview_on_accent" />

        <ImageView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="2dp"
            android:contentDescription="@null"
            android:padding="8dp"
            android:src="@drawable/ic_widget_next"
            android:tint="@color/widget_preview_ink" />
    </LinearLayout>
</LinearLayout>
