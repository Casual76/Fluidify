<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Sampled from the icon's own plate by tools/icon.py, so the
         adaptive icon's background and its artwork meet invisibly. -->
    <color name="ic_launcher_background">#222222</color>

    <!-- Where the artwork does not reach. Kept in step with PageFloorDark and
         PageFloorLight in SquareApp.kt: the starting window and the first frame
         Compose draws have to be the same colour, or every cold start begins
         with a flash of the other one. -->
    <color name="page_floor_dark">#FF0A0A0C</color>
    <color name="page_floor_light">#FFF1F2F6</color>

    <!-- The widget's preview in the picker, which is a static layout and so cannot
         ask the engine for its palette. Kept close to what engineWidgetPalette
         resolves for the brand accent; see res/layout/now_playing_widget_preview.xml. -->
    <color name="widget_preview_background">#FFF3F0F7</color>
    <color name="widget_preview_card">#FFE7E2EE</color>
    <color name="widget_preview_ink">#FF1B1B1F</color>
    <color name="widget_preview_ink_dim">#FF6B6873</color>
    <color name="widget_preview_accent">#FFE9DDFF</color>
    <color name="widget_preview_on_accent">#FF25005B</color>

    <!-- I colori di partenza della scheda del widget, portati da Pampa Widgets insieme a lei.
         Sono le tinte dei glifi e dei riempimenti prima che il disegnatore li ricolori dal
         quadro: vivono qui perche' i vettori dei tasti li nominano, e il disegnatore applica
         il proprio sopra. Vedi MediaWidgetUpdater. -->
    <color name="widget_on_surface">#F8FFFB</color>
    <color name="widget_on_surface_variant">#DDE7E0</color>
    <color name="widget_primary">#F5FFF9</color>
    <color name="widget_on_primary">#102018</color>
    <color name="widget_accent">#DDFBEA</color>
</resources>
