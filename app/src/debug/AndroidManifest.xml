<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The diagnostic entry remains internal and debug-only. Bluetooth declarations
         live in main; permission prompts still require an explicit setup action. -->
    <application>
        <activity
            android:name="dev.lelonio.square.airpods.AirPodsDiagnosticActivity"
            android:exported="false" />
        <!-- Listening-stats glass stage: invented data only, no account, no service. Exported so
             a capture session can open it by name over adb; it exists in debug builds only and
             reads nothing but its own presentation extras (theme, font scale, width). -->
        <activity
            android:name="dev.lelonio.square.ui.library.stats.ListeningStatsGlassPreviewActivity"
            android:exported="true" />
        <!-- AirPods glass stage: invented state only, no runtime owner, socket, service or
             stored configuration. Exported for the same reason as the stage above: a capture
             session opens it by name over adb. Debug builds only; it reads nothing but its
             own presentation extras (view, theme, state, font scale, width). -->
        <activity
            android:name="dev.lelonio.square.ui.airpods.AirPodsGlassPreviewActivity"
            android:exported="true" />
    </application>
</manifest>
