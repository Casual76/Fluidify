<?xml version="1.0" encoding="utf-8"?>
<!--
  The bench, and deliberately not a launcher icon.

  A separate activity rather than a route inside the app, because the app's own entry needs an
  account and the bench does not: that is the whole reason it exists. But it used to carry
  CATEGORY_LAUNCHER as well, which put a second "Fluidify glass" icon in the drawer of any phone a
  dev build was installed on - and a second icon beside the real app is indistinguishable from the
  app having gone wrong. It cost someone their login.

  So it is exported and nameable, and nothing else. Started by hand:

    adb shell am start -n dev.pampa.fluidify/dev.lelonio.square.gallery.GlassGalleryActivity
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <activity
            android:name="dev.lelonio.square.gallery.GlassGalleryActivity"
            android:exported="true"
            android:label="Fluidify glass"
            android:theme="@style/Theme.Fluidify">
        </activity>
    </application>
</manifest>
