<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />

    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The icon on the watch face is an ongoing notification underneath. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Playing on the watch itself. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Asking for Wi-Fi (or mobile data) instead of the Bluetooth link to the phone. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <!-- To hear headphones connect, for the "listen here?" prompt. Asked for in Altro. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <application
        android:name=".WearApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FluidifyWear">
        <meta-data android:name="dev.pampa.fluidify.WEAR_APK" android:value="true" />

        <!--
          Not standalone: the remote is the point, and the phone app is what it
          remotes. Play and the system use this to tell people the watch app
          needs its phone counterpart.
        -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:taskAffinity="">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Wear's phone media controls resolve this action in the companion
                 package before falling back to the system player. -->
            <intent-filter>
                <action android:name="com.google.android.wearable.action.MEDIA_CONTROLS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Public Wear SDK action for systems using the newer remote-session contract. -->
            <intent-filter>
                <action android:name="com.google.wear.services.media.action.REMOTE_MEDIA_ACTIVITY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver android:name=".update.WatchInstallResultReceiver" android:exported="false" />
        <activity android:name=".update.WatchInstallConfirmationActivity" android:exported="false"
            android:excludeFromRecents="true" android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!--
          Where the phone's state, covers and replies land, also with the app
          closed. Only Fluidify's own paths wake it.
        -->
        <service
            android:name=".link.WatchListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <action android:name="com.google.android.gms.wearable.CHANNEL_EVENT" />
                <data
                    android:host="*"
                    android:pathPrefix="/fluidify"
                    android:scheme="wear" />
            </intent-filter>
        </service>

        <!-- The watch playing on its own; see standalone/WatchPlaybackService. -->
        <service
            android:name=".standalone.WatchPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!-- Headphones connecting to the watch, and the prompt's own button. -->
        <receiver
            android:name=".standalone.HeadphonesReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
            </intent-filter>
        </receiver>

        <!-- The Fluidify tile: the player, one swipe from the watch face. -->
        <service
            android:name=".system.PlayerTileService"
            android:exported="true"
            android:label="@string/tile_label"
            android:icon="@drawable/ic_notification"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview" />
        </service>

        <!-- Presses on the tile; only the tile's own pending intents reach it. -->
        <receiver
            android:name=".system.TileActionReceiver"
            android:exported="false" />

        <!-- The song, the cover or the mark on any watch face that takes a complication. -->
        <service
            android:name=".system.NowPlayingComplicationService"
            android:exported="true"
            android:label="@string/complication_label"
            android:icon="@drawable/ic_notification"
            android:permission="com.google.android.wearable.permission.BIND_COMPLICATION_PROVIDER">
            <intent-filter>
                <action android:name="android.support.wearable.complications.ACTION_COMPLICATION_UPDATE_REQUEST" />
            </intent-filter>
            <meta-data
                android:name="android.support.wearable.complications.SUPPORTED_TYPES"
                android:value="SHORT_TEXT,LONG_TEXT,SMALL_IMAGE,PHOTO_IMAGE,MONOCHROMATIC_IMAGE,RANGED_VALUE" />
            <!-- Pushed when the song changes; the face never has to ask on a timer. -->
            <meta-data
                android:name="android.support.wearable.complications.UPDATE_PERIOD_SECONDS"
                android:value="0" />
        </service>

    </application>

</manifest>
